# Copy this file to .env and set the published API base URL from Xano.
# XANO_SERVICES_API_URL is optional when it is the same as XANO_API_URL.
# XANO_CONTACTS_API_URL is optional when it is the same as XANO_API_URL.
# XANO_APPOINTMENTS_API_URL is optional when it is the same as XANO_API_URL.
# XANO_FINANCE_API_URL must use the Finance API group base URL (api:PCFin01),
# not the Authentication API URL in XANO_API_URL.
# FINANCE_MOCK_ENABLED enables sample financial data only if the API is not configured.
XANO_API_URL=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
XANO_SERVICES_API_URL=
XANO_CONTACTS_API_URL=
XANO_APPOINTMENTS_API_URL=
XANO_FINANCE_API_URL=
FINANCE_MOCK_ENABLED=false